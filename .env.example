# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Korean market — required for KR fundamental data via DART
DART_API_KEY=...

# US market — optional; yfinance is used as fallback when absent
FMP_API_KEY=...
ALPHA_VANTAGE_API_KEY=...

# Cache
CACHE_TTL_SECONDS=3600

# Report output
REPORT_FORMAT=markdown
